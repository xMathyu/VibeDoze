    <Geometry x:Key="G.Moon">M19 14.5 A7.5 7.5 0 0 1 9.5 5 A7.5 7.5 0 1 0 19 14.5 Z</Geometry>
    <Geometry x:Key="G.Power">M12 3.5 V11.5 M7.2 6.2 A7.5 7.5 0 1 0 16.8 6.2</Geometry>
