    <Geometry x:Key="G.Sparkle">M12 3.5 L13.9 8.1 L18.5 10 L13.9 11.9 L12 16.5 L10.1 11.9 L5.5 10 L10.1 8.1 Z M18.5 16 V20 M16.5 18 H20.5</Geometry>
    <Geometry x:Key="G.Laptop">M5 6.5 H19 A1 1 0 0 1 20 7.5 V16 H4 V7.5 A1 1 0 0 1 5 6.5 Z M2.5 18.5 H21.5</Geometry>
