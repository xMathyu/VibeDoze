<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:VibeDoze.UI">

    <!-- Colours live in VD.* brushes set by ThemeManager (light / dark, following Windows). -->

    <FontFamily x:Key="VD.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="VD.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- ───────── Icons (24×24, stroked unless used with Filled) ───────── -->
