    <!-- ───────── Text ───────── -->
    <Style x:Key="VD.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource VD.Sub}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="VD.RowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource VD.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="VD.GroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource VD.Sub}" />
        <Setter Property="Margin" Value="4,0,0,8" />
    </Style>

    <!-- ───────── Surfaces ───────── -->
    <Style x:Key="VD.ModuleCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource VD.Module}" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style x:Key="VD.GroupCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource VD.Group}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VD.GroupBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <!-- One row of a grouped list; rows after the first get a hairline on top (VD.RowNext). -->
    <Style x:Key="VD.Row" TargetType="Border">
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource VD.Sep}" />
    </Style>
    <Style x:Key="VD.RowNext" TargetType="Border" BasedOn="{StaticResource VD.Row}">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style x:Key="VD.Chip" TargetType="Border">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource VD.Fill}" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style x:Key="VD.IconTile" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ───────── iOS-style switch ───────── -->
    <Style x:Key="VD.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="26" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="13" Background="{DynamicResource VD.SwitchOff}" />
                        <Ellipse x:Name="Knob" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Border x:Name="Focus" CornerRadius="16" Margin="-3" BorderThickness="2"
                                BorderBrush="{DynamicResource VD.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource VD.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── Control Center tile: icon circle + two lines; Tag = icon geometry ───────── -->
    <Style x:Key="VD.Tile" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource VD.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{DynamicResource VD.Module}" CornerRadius="18" Padding="12,10"
                            BorderThickness="1.5" BorderBrush="Transparent">
                        <DockPanel>
                            <Border x:Name="Circle" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18"
                                    Background="{DynamicResource VD.Fill}" VerticalAlignment="Center">
                                <ui:GlyphIcon x:Name="Glyph" Width="19" Height="19" Foreground="{DynamicResource VD.Text}"
                                              Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource VD.Accent}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource VD.ModuleHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource VD.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── Segmented control item ───────── -->
    <Style x:Key="VD.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource VD.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="8" Height="30" Background="Transparent" BorderThickness="1.5" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource VD.FillHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource VD.SegOn}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource VD.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── Buttons ───────── -->
    <Style x:Key="VD.Capsule" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource VD.Text}" />
        <Setter Property="Background" Value="{DynamicResource VD.Module}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}"
                            BorderThickness="1.5" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource VD.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="VD.CapsuleFill" TargetType="Button" BasedOn="{StaticResource VD.Capsule}">
        <Setter Property="Background" Value="{DynamicResource VD.Fill}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style x:Key="VD.CapsuleAccent" TargetType="Button" BasedOn="{StaticResource VD.Capsule}">
        <Setter Property="Background" Value="{DynamicResource VD.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="VD.IconButton" TargetType="Button" BasedOn="{StaticResource VD.Capsule}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="VD.Link" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource VD.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="8,6" BorderThickness="1.5" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource VD.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource VD.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── Settings sidebar item ───────── -->
    <Style x:Key="VD.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource VD.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="8" Height="34" Padding="7,0" Background="Transparent" BorderThickness="1.5" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource VD.Fill}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource VD.Accent}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource VD.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
