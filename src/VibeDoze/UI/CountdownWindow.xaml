<Window x:Class="VibeDoze.UI.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeDoze"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        UseLayoutRounding="True">
    <StackPanel Margin="22,20,22,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Top">
                <Ellipse x:Name="Halo" Opacity="0.18" />
                <TextBlock x:Name="Seconds" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="Reason" Style="{StaticResource Secondary}" Margin="0,3,0,0" FontSize="13" />
            </StackPanel>
        </Grid>
        <ProgressBar x:Name="Progress" Height="4" Margin="0,16,0,16" Minimum="0" Maximum="1" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PostponeButton" Content="Posponer 15 min" Margin="0,0,8,0" Click="OnPostpone" />
            <Button x:Name="CancelButton" Content="Cancelar" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="NowButton" Content="Ahora" Style="{DynamicResource AccentButtonStyle}" Click="OnNow" />
        </StackPanel>
    </StackPanel>
</Window>
